{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lisichikademo",
  "compatibility_date": "2026-08-15",
  "build": {
    "command": "pnpm build"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  }
}
